# =============================================================================
# Williams InfoSec LLC — Baseline .gitignore
# Drop into the root of every repo. Edit per-repo as needed.
# =============================================================================

# --- PII guardrail (Williams InfoSec convention) ---
# Any file prefixed PII_ never gets committed. Aligns with script output policy.
PII_*
**/PII_*

# --- Secrets & credentials ---
*.pem
*.key
*.pfx
*.p12
*.crt
*.cer
*.env
*.env.*
.env
.env.local
.env.*.local
secrets/
credentials/
*credentials*
*secret*
*.token
*.tokens
azureauth.json
gcp-key*.json
service-account*.json
.aws/
.azure/
.gcloud/

# --- Client / tenant identifiers in plain text ---
# Never commit raw exports from tenant discovery
tenant-export*.json
subscription-export*.csv
gcp-org-export*.json

# --- Script execution artifacts ---
# Anything written to the public outputs dir should never come back into Git
TenantLockAudit_*.csv
*_RBAC_Audit_*.csv
*_NSG_Inventory_*.csv
*_findings_*.json
audit_*.log
*.log
logs/

# --- Build & dependency outputs ---
node_modules/
dist/
build/
out/
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# --- IDE & OS ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- Office temp / lock files ---
~$*
*.tmp
*.bak

# --- Slide / doc generation byproducts ---
*.pdf.tmp
slide-preview-*.jpg
slide-preview-*.png

# --- Allow brand assets ---
!Asset_4_20230417_16_27_07.png
!**/brand/*.png
!**/brand/*.svg

# === Williams InfoSec code-only guard (managed by Sync-WISGitRepos.ps1) ===
# ALLOWLIST. Everything is ignored, then code is added back.
# Fails closed: unknown file types stay out, in VS Code too.

# 1. Ignore everything
*

# 2. But let git descend into directories
!*/

# 3. Allow code back in
!*.adoc
!*.bash
!*.bat
!*.bicep
!*.cfg
!*.cjs
!*.cmd
!*.code-workspace
!*.conf
!*.cs
!*.css
!.dockerignore
!.editorconfig
!.gitattributes
!.gitignore
!.gitmodules
!*.go
!*.gs
!*.hcl
!*.htm
!*.html
!*.ini
!*.j2
!*.java
!*.jinja
!*.js
!*.json
!*.jsonc
!*.jsx
!*.md
!*.mjs
!.npmrc
!.nvmrc
!*.php
!*.pl
!*.properties
!*.ps1
!*.ps1xml
!*.psd1
!*.psm1
!*.py
!*.r
!*.rb
!*.rst
!*.scss
!*.sh
!*.sql
!*.tf
!*.tfstate.example
!*.tfvars
!*.toml
!*.tpl
!*.ts
!*.tsx
!*.xml
!*.yaml
!*.yml
!*.zsh

# 4. Allow extensionless code and repo metadata
!.editorconfig
!.gitattributes
!.gitignore
!CODEOWNERS
!Dockerfile
!LICENCE
!LICENSE
!Makefile
!NOTICE

# 5. Generated output stays out even when the extension is allowed
transcripts/
node_modules/
__pycache__/
.venv/
dist/
build/
out/
logs/
.terraform/
*_Audit_*.csv
*_Log_*.log
Phase*_Deploy_*.csv
*_RBAC_Audit_*.csv
*_NSG_Inventory_*.csv
TenantLockAudit_*.csv
audit_*.log
downloaded.txt
_action-log.csv
*findings*.json
*export*.json
*export*.xml
*inventory*.json
*audit*.json
*audit*.xml
*report*.json
*results*.json
*dump*.json
tenant-export*.json
gcp-org-export*.json
subscription-export*.csv

# 6. Secrets stay out. Last word, beats every rule above.
PII_*
*.pem
*.key
*.pfx
*.p12
*.env
.env
*credentials*
*secret*
*.token
azureauth.json
gcp-key*.json
service-account*.json
*.tfstate
*.tfstate.backup
terraform.tfvars
id_rsa*
*.ovpn
# === end code-only guard ===
